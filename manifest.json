{
  "manifest_version": 3,
  "version": "2.4.0.2",
  "default_locale": "en",
  "name": "Just Lyrics",
  "description": "Shows live synced lyrics on YouTube Music",
  "homepage_url": "https://betterlyrics.org",
  "icons": {
    "16": "images/icons/icon-16.png",
    "48": "images/icons/icon-48.png",
    "512": "images/icons/icon-512.png"
  },
  "chromium:key": "",
  "host_permissions": [
    "*://music.youtube.com/*"
  ],
  "permissions": [
    "storage"
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://api.fontshare.com https://fonts.googleapis.com; font-src 'self' data: https://cdn.fontshare.com https://fonts.gstatic.com; img-src 'self' data: https://betterlyrics.org; connect-src https://lyrics.api.dacubeking.com"
  },
  "web_accessible_resources": [
    {
      "matches": [
        "*://music.youtube.com/*"
      ],
      "resources": [
        "css/blyrics/*.css"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "*://music.youtube.com/*"
      ],
      "js": [
        "src/index.ts"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "*://music.youtube.com/*"
      ],
      "js": [
        "public/earlyInject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://music.youtube.com/*"
      ],
      "js": [
        "public/script.js"
      ],
      "run_at": "document_end",
      "world": "MAIN"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "betterlyrics@boidu.dev",
      "strict_min_version": "128.0"
    },
    "gecko_android": {}
  }
}
